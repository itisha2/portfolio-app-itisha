###  https://example.org/sds-ontology#SignalWord
sds:SignalWord rdf:type owl:Class ;
               rdfs:comment "The GHS word ('Danger' or 'Warning') used on a label to indicate the relative severity of a hazard."@en ;
               rdfs:label "GHS Signal Word"@en ;
               sds:example "sds:Warning a sds:SignalWord ; rdfs:label \"Warning\"@en ."@en .


###  https://example.org/sds-ontology#SkinProtection
sds:SkinProtection rdf:type owl:Class ;
                   rdfs:subClassOf sds:PPE ;
                   rdfs:comment "PPE designed to shield the skin from contact with the product, its dust, or hot/molten material."@en ;
                   rdfs:label "Skin Protection"@en ;
                   sds:example ":ppeX a sds:SkinProtection ; rdfs:label \"Long-sleeved protective clothing\"@en ."@en .


###  https://example.org/sds-ontology#StorageRequirement
sds:StorageRequirement rdf:type owl:Class ;
                       rdfs:comment "A condition or precaution recommended for safely storing the product when not in use."@en ;
                       rdfs:label "Storage Requirement"@en ;
                       sds:example ":requirementX a sds:StorageRequirement ; rdfs:label \"Store in a dry, cool area\"@en ."@en .


###  https://example.org/sds-ontology#Substance
sds:Substance rdf:type owl:Class ;
              rdfs:subClassOf sds:Product ;
              rdfs:comment "A single chemical species with one defined composition, as distinct from a multi-ingredient mixture."@en ;
              rdfs:label "Substance"@en ;
              skos:closeMatch <http://purl.obolibrary.org/obo/CHEBI_59999> ;
              sds:example ":substanceX a sds:Substance ; sds:casNumber \"0000-00-0\" ."@en .


###  https://example.org/sds-ontology#Supplier
sds:Supplier rdf:type owl:Class ;
             rdfs:subClassOf sds:Organization ;
             rdfs:comment "The organization that supplies or distributes the product to customers, which may differ from the manufacturer."@en ;
             rdfs:label "Supplier"@en ;
             rdfs:seeAlso oriont:Agent ;
             sds:example ":supplierX a sds:Supplier ; sds:phoneNumber \"+1-000-000-0000\" ."@en .


###  https://example.org/sds-ontology#TargetOrganSystem
sds:TargetOrganSystem rdf:type owl:Class ;
                      rdfs:comment "A body system or organ that a chemical's toxicological effects are known to specifically affect."@en ;
                      rdfs:label "Target Organ System"@en ;
                      sds:example ":respiratoryTract a sds:TargetOrganSystem ; rdfs:label \"Respiratory tract\"@en ."@en .


###  https://example.org/sds-ontology#ToxicologicalEffect
sds:ToxicologicalEffect rdf:type owl:Class ;
                        rdfs:comment "A documented biological effect of the product or a component on living organisms, such as irritation or carcinogenicity."@en ;
                        rdfs:label "Toxicological Effect"@en ;
                        sds:example ":effectX a sds:ToxicologicalEffect ; rdfs:label \"Lung tumors observed in animal studies\"@en ."@en .


###  https://example.org/sds-ontology#TransportClassification
sds:TransportClassification rdf:type owl:Class ;
                            rdfs:comment "The regulatory classification of the product for shipment under transport regulations such as DOT, IMDG, or IATA."@en ;
                            rdfs:label "Transport Classification"@en ;
                            sds:example ":transportX a sds:TransportClassification ; sds:transportStatusText \"Not regulated as hazardous for shipment\"@en ."@en .


###  https://example.org/sds-ontology#UnsuitableExtinguishingMedia
sds:UnsuitableExtinguishingMedia rdf:type owl:Class ;
                                 rdfs:subClassOf sds:ExtinguishingMedia ;
                                 rdfs:comment "An extinguishing agent that is specifically discouraged because it could worsen the fire or create a hazard."@en ;
                                 rdfs:label "Unsuitable Extinguishing Media"@en ;
                                 sds:example ":mediaX a sds:UnsuitableExtinguishingMedia ; rdfs:label \"Solid water stream\"@en ."@en .


###  https://example.org/sds-ontology#Warning
sds:Warning rdf:type owl:Class ;
            rdfs:subClassOf sds:SignalWord ;
            rdfs:comment "GHS signal word for less severe hazard categories."@en ;
            rdfs:label "Warning"@en .


###  https://example.org/sds-ontology#WasteDisposalMeasure
sds:WasteDisposalMeasure rdf:type owl:Class ;
                         rdfs:comment "A recommended method for disposing of unused product, residues, or contaminated packaging."@en ;
                         rdfs:label "Waste Disposal Measure"@en ;
                         rdfs:seeAlso oriont:WasteFlow ;
                         sds:example ":measureX a sds:WasteDisposalMeasure ; rdfs:label \"Dispose of in accordance with local regulations\"@en ."@en .


